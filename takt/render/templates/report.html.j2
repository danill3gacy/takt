<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Такт — отчёт по сопернику: {{ r.opponent }}</title>
<style>
:root{
  --bg:#0a111c; --panel:#111d2e; --panel2:#16243a; --line:#22374f;
  --accent:#3b82e8; --accent-soft:#8fbdf5; --text:#e9f0f9; --muted:#8ba2c0;
  --hi:#e2593f; --mid:#d9a441; --low:#54759f; --ok:#3fae7a;
  --mono:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);
  font:15px/1.55 -apple-system,BlinkMacSystemFont,"Segoe UI",Inter,Roboto,Helvetica,Arial,sans-serif;}
a{color:inherit}
.wrap{max-width:1240px;margin:0 auto;padding:0 22px 80px}

header{border-bottom:1px solid var(--line);background:linear-gradient(180deg,#0e1a2b,#0a111c);}
.head{max-width:1240px;margin:0 auto;padding:22px;display:flex;gap:22px;align-items:center;flex-wrap:wrap}
.crest{width:52px;height:52px;border-radius:10px;background:linear-gradient(145deg,#2f6fd0,#12melt);
  background:linear-gradient(145deg,#3b82e8,#17427f);display:flex;align-items:center;justify-content:center;
  font-weight:800;font-size:21px;letter-spacing:-.5px;flex:0 0 auto}
.head h1{margin:0;font-size:20px;font-weight:650;letter-spacing:-.2px}
.head .sub{color:var(--muted);font-size:13px;margin-top:3px}
.head .right{margin-left:auto;text-align:right;color:var(--muted);font-size:12.5px;line-height:1.7}
.badge{display:inline-block;padding:2px 8px;border:1px solid var(--line);border-radius:20px;
  font-size:11.5px;color:var(--accent-soft);background:#0e1b2c}

nav{position:sticky;top:0;z-index:30;background:rgba(10,17,28,.94);backdrop-filter:blur(8px);
  border-bottom:1px solid var(--line)}
.tabs{max-width:1240px;margin:0 auto;padding:0 22px;display:flex;gap:2px}
.tab{padding:13px 16px;font-size:14px;color:var(--muted);cursor:pointer;border-bottom:2px solid transparent;
  user-select:none}
.tab:hover{color:var(--text)}
.tab.on{color:var(--text);border-bottom-color:var(--accent)}
.tab .n{font-size:11px;color:var(--low);margin-left:5px}

section.page{display:none;padding-top:26px}
section.page.on{display:block}

h2{font-size:13px;letter-spacing:.09em;text-transform:uppercase;color:var(--muted);
  font-weight:600;margin:34px 0 13px}
h2:first-child{margin-top:6px}
.note{color:var(--muted);font-size:12.5px;margin:-6px 0 12px;max-width:820px}

.card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:16px 18px}
.grid{display:grid;gap:14px}
.g2{grid-template-columns:repeat(2,1fr)}
.g3{grid-template-columns:repeat(3,1fr)}
.g4{grid-template-columns:repeat(4,1fr)}
@media(max-width:900px){.g2,.g3,.g4{grid-template-columns:1fr}}

/* тезисы */
.ins{border:1px solid var(--line);border-left:3px solid var(--low);background:var(--panel);
  border-radius:9px;margin-bottom:9px;overflow:hidden}
.ins.high{border-left-color:var(--hi)}
.ins.mid{border-left-color:var(--mid)}
.ins .top{display:flex;gap:14px;align-items:flex-start;padding:13px 16px;cursor:pointer}
.ins .txt{flex:1;font-size:15.5px;line-height:1.45}
.ins .meta{color:var(--muted);font-size:12.2px;margin-top:6px}
.kind{font-size:10.5px;text-transform:uppercase;letter-spacing:.07em;padding:2px 7px;border-radius:4px;
  border:1px solid var(--line);color:var(--muted);flex:0 0 auto;margin-top:2px}
.kind.fact{color:#9fd3b4;border-color:#28513f;background:#0f2419}
.kind.hyp{color:#e6c37f;border-color:#54401c;background:#241a08}
.clipbtn{flex:0 0 auto;font-size:12.5px;color:var(--accent-soft);border:1px solid var(--line);
  background:#0e1b2c;border-radius:6px;padding:5px 10px;white-space:nowrap;margin-top:1px}
.clipbtn:hover{border-color:var(--accent);color:#fff}
.ins .body{display:none;padding:0 16px 14px;border-top:1px solid var(--line);margin-top:0}
.ins.open .body{display:block}
.cmp{display:flex;gap:16px;flex-wrap:wrap;margin:12px 0 6px;font-size:12.5px;color:var(--muted)}
.cmp b{color:var(--text);font-weight:600}
.detail{font-size:13px;color:var(--muted);margin-top:10px;line-height:1.6}

.clips{margin-top:12px;display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:8px;
  max-height:330px;overflow:auto;padding-right:4px}
.clip{border:1px solid var(--line);border-radius:7px;padding:9px 11px;background:var(--panel2);cursor:pointer}
.clip:hover{border-color:var(--accent)}
.clip .t{font-family:var(--mono);font-size:12px;color:var(--accent-soft)}
.clip .ttl{font-size:12.6px;margin-top:3px;line-height:1.35}
.clip .m{font-size:11.3px;color:var(--muted);margin-top:4px}

/* плитки */
.tile{background:var(--panel);border:1px solid var(--line);border-radius:11px;padding:14px 15px}
.tile .k{font-size:12px;color:var(--muted);min-height:32px}
.tile .v{font-size:26px;font-weight:650;margin-top:5px;letter-spacing:-.5px}
.tile .d{font-size:11.8px;color:var(--muted);margin-top:4px}
.tile .d.up{color:var(--ok)} .tile .d.down{color:var(--hi)}

/* таблицы */
table{width:100%;border-collapse:collapse;font-size:13.2px}
th{text-align:left;color:var(--muted);font-weight:500;font-size:11.5px;text-transform:uppercase;
  letter-spacing:.05em;padding:7px 9px;border-bottom:1px solid var(--line);white-space:nowrap}
td{padding:7px 9px;border-bottom:1px solid #17293f}
tr:hover td{background:#132135}
td.num,th.num{text-align:right;font-family:var(--mono);font-size:12.4px}
.bar{height:5px;background:#1c2f47;border-radius:3px;overflow:hidden;margin-top:4px}
.bar i{display:block;height:100%;background:var(--accent)}

.pitch{width:100%;height:auto;display:block}
.legend{display:flex;gap:14px;flex-wrap:wrap;font-size:11.8px;color:var(--muted);margin-top:9px}
.legend i{display:inline-block;width:10px;height:10px;border-radius:2px;margin-right:5px;vertical-align:-1px}

input[type=search],select{background:var(--panel2);border:1px solid var(--line);color:var(--text);
  border-radius:8px;padding:11px 13px;font-size:14px;width:100%;outline:none;font-family:inherit}
input[type=search]:focus{border-color:var(--accent)}
.chips{display:flex;gap:7px;flex-wrap:wrap;margin-top:11px}
.chip{font-size:12.5px;border:1px solid var(--line);background:var(--panel2);border-radius:16px;
  padding:5px 11px;cursor:pointer;color:var(--muted)}
.chip:hover,.chip.on{border-color:var(--accent);color:var(--text)}

.status{font-size:11.5px;padding:2px 7px;border-radius:4px;border:1px solid var(--line)}
.status.ok{color:#9fd3b4;border-color:#28513f;background:#0f2419}
.status.no{color:#e8a08e;border-color:#57302a;background:#26120e}
.status.empty{color:var(--muted)}

footer{margin-top:52px;padding-top:20px;border-top:1px solid var(--line);color:var(--muted);font-size:12.4px;
  line-height:1.75}
footer b{color:var(--text)}
.warn{border:1px solid #4a3a18;background:#1d1707;border-radius:9px;padding:13px 15px;font-size:13px;
  color:#e6cf9f;margin:14px 0}
</style>
</head>
<body>

<header>
  <div class="head">
    <div class="crest">{{ r.club_short }}</div>
    <div>
      <h1>Отчёт по сопернику — {{ r.opponent_full }}</h1>
      <div class="sub">{{ r.club }} · подготовлено {{ r.generated }} · {{ r.n_matches }} матча,
        {{ r.minutes }} минут игрового времени</div>
    </div>
    <div class="right">
      <span class="badge">источник: {{ r.source }}</span><br>
      {{ r.competition }}<br>
      расчёт занял секунды, не неделю
    </div>
  </div>
</header>

<nav><div class="tabs">
  <div class="tab on" data-p="report">Отчёт<span class="n" id="n-ins"></span></div>
  <div class="tab" data-p="patterns">Поиск по паттернам<span class="n" id="n-pat"></span></div>
  <div class="tab" data-p="playlist">Плейлист<span class="n" id="n-clip"></span></div>
  <div class="tab" data-p="players">Игроки</div>
  <div class="tab" data-p="feed">Фид и метод</div>
</div></nav>

<div class="wrap">

<!-- ============================ ОТЧЁТ ============================ -->
<section class="page on" id="p-report">
  <h2>Что важно знать перед установкой</h2>
  <div class="note">Тезисы отсортированы по весу: сила отклонения от лиги × объём наблюдений.
    <b>Факт</b> — арифметика над данными. <b>Гипотеза</b> — интерпретация, требующая проверки глазом.
    У каждого тезиса есть эпизоды: нажмите, чтобы раскрыть.</div>
  <div id="insights"></div>

  <h2>Ключевые показатели</h2>
  <div class="grid g4" id="tiles"></div>

  <h2>Средние позиции и связи передач</h2>
  <div class="note">Позиция усреднена по действиям с мячом и открываниям под передачу.
    Толщина связи — число передач между игроками. Атака слева направо.</div>
  <div class="card"><svg class="pitch" id="pitch-pos" viewBox="0 0 1050 680"></svg></div>

  <h2>Форма блока без мяча</h2>
  <div class="note">Прямоугольник — площадь, которую команда реально закрывает: ширина между крайними
    игроками × расстояние от последней линии до первой. Красным по краям — полоса, которую блок
    не перекрывает вовсе.</div>
  <div class="grid g3" id="pitch-block-host"></div>

  <h2>Высота последней линии по фазам</h2>
  <div class="card" id="dline"></div>

  <div class="grid g2" style="margin-top:14px">
    <div>
      <h2>Карта созданной угрозы</h2>
      <div class="note">Сумма xT за матч по зонам. Атака слева направо.</div>
      <div class="card"><svg class="pitch" id="heat-threat" viewBox="0 0 1050 680"></svg></div>
    </div>
    <div>
      <h2>Зоны возврата мяча</h2>
      <div class="note">Где команда отбирает и подбирает. Их атака слева направо.</div>
      <div class="card"><svg class="pitch" id="heat-regain" viewBox="0 0 1050 680"></svg></div>
    </div>
  </div>

  <h2>Ритм матча</h2>
  <div class="card" id="rhythm"></div>

  <div class="grid g2" style="margin-top:14px">
    <div>
      <h2>Стандарты</h2>
      <div class="card" id="setpieces"></div>
    </div>
    <div>
      <h2>Матчи выборки</h2>
      <div class="card" id="matches"></div>
    </div>
  </div>
</section>

<!-- ========================== ПАТТЕРНЫ ========================== -->
<section class="page" id="p-patterns">
  <h2>Поиск по тактическим паттернам</h2>
  <div class="note">Наберите, что нужно найти. Каждый паттерн — детерминированный фильтр по событиям,
    а не запрос к языковой модели: один и тот же запрос всегда даёт одну и ту же выборку.
    В боевом контуре фразу разбирает модель, но сам поиск остаётся воспроизводимым.</div>
  <input type="search" id="q" placeholder="например: забегание за спину · высокий прессинг · смена фланга · потеря в своей трети" autocomplete="off">
  <div class="chips" id="chips"></div>
  <div id="pat-results" style="margin-top:18px"></div>
</section>

<!-- ========================== ПЛЕЙЛИСТ ========================== -->
<section class="page" id="p-playlist">
  <h2>Плейлист эпизодов</h2>
  <div class="note">Все эпизоды, на которые ссылаются тезисы и паттерны. Нажатие открывает момент матча
    по тайм-коду — в демо видеофайла нет, поэтому показывается карточка эпизода.</div>
  <div class="grid g3">
    <select id="f-match"></select>
    <select id="f-pattern"></select>
    <select id="f-sort">
      <option value="t">по времени матча</option>
      <option value="match">по матчу</option>
    </select>
  </div>
  <div id="playlist" style="margin-top:16px"></div>
</section>

<!-- =========================== ИГРОКИ =========================== -->
<section class="page" id="p-players">
  <h2>Игроки</h2>
  <div class="note" id="players-note"></div>
  <div class="card" style="overflow:auto" id="players"></div>
</section>

<!-- ============================ ФИД ============================ -->
<section class="page" id="p-feed">
  <h2>Что посчитано и от каких данных это зависит</h2>
  <div class="note">Каждая метрика объявляет, какие возможности фида ей нужны. Если поставщик их не даёт,
    метрика не считается и попадает в «нет данных» — вместо того, чтобы вернуть число, посчитанное не из того.
    По этой таблице видно, что появится в отчёте сразу после подключения к фиду лиги.</div>
  <div class="card" style="overflow:auto" id="caps"></div>

  <h2>Возможности текущего источника</h2>
  <div class="card"><div class="chips" id="capchips"></div></div>

  <h2>Сравнение с лигой</h2>
  <div class="note">Медиана по всем командам, для которых есть данные ({{ r.baseline.n_teams }} команд,
    {{ r.baseline.n_matches }} матчей). Без этой колонки число «высота линии 35 м» не значит ничего.</div>
  <div class="card" style="overflow:auto" id="bl"></div>

  <div class="warn">
    <b>Ограничения этой версии.</b>
    Кнопка эпизода не открывает видео — видеофайлов в открытом датасете нет; в контуре клуба здесь
    открывается момент матча по тайм-коду. Данные — открытый датасет SkillCorner (A-League 2024/25),
    он взят потому, что по типу совпадает с тем, что даёт оптическая система лиги: трекинг с камер →
    производные события. Российских матчей ни в одном открытом датасете не существует, поэтому
    реальный отчёт по клубу РПЛ появится только после подключения к фиду лиги.
    Набор метрик на другом фиде будет отличаться — что именно посчитается, видно в таблице выше.
  </div>
</section>

<footer>
  <b>Такт</b> — надстройка над данными лиги для тренерского штаба.<br>
  Все числа в отчёте посчитаны из данных пайплайном на Python; ни одно не введено руками.
  Ни один тезис не выпущен без эпизодов, которые его подтверждают.<br>
  Система считает и показывает. Что сказать команде — решает тренер.
</footer>
</div>

<script id="data" type="application/json">{{ data_json }}</script>
<script>
const R = JSON.parse(document.getElementById('data').textContent);
const M = R.metrics || {};
const $ = s => document.querySelector(s);
const el = (t,c,h) => { const e=document.createElement(t); if(c)e.className=c; if(h!==undefined)e.innerHTML=h; return e; };
const num = v => (v===null||v===undefined||Number.isNaN(v)) ? '—' : v;

/* ------------------------------- вкладки ------------------------------- */
document.querySelectorAll('.tab').forEach(t=>t.onclick=()=>{
  document.querySelectorAll('.tab').forEach(x=>x.classList.remove('on'));
  document.querySelectorAll('.page').forEach(x=>x.classList.remove('on'));
  t.classList.add('on'); $('#p-'+t.dataset.p).classList.add('on'); window.scrollTo(0,0);
});

/* ------------------------------- тезисы -------------------------------- */
function clipCard(c){
  const d = el('div','clip');
  d.innerHTML = `<div class="t">${c.timecode} · ${c.clock}</div>
    <div class="ttl">${c.title||''}</div>
    <div class="m">${c.match}</div>`;
  d.onclick = ()=>openClip(c);
  return d;
}
function renderInsights(){
  const box = $('#insights');
  R.insights.forEach(i=>{
    const d = el('div','ins '+i.level);
    const kind = i.kind==='факт' ? 'fact':'hyp';
    d.innerHTML = `<div class="top">
        <span class="kind ${kind}">${i.kind}</span>
        <div class="txt">${i.text}<div class="meta">${i.evidence}</div></div>
        <span class="clipbtn">${i.clips.length} эпизодов ▾</span>
      </div>
      <div class="body">
        ${i.comparison ? `<div class="cmp">
            <span>${i.comparison.label}: <b>${i.comparison.value}</b></span>
            <span>медиана лиги: <b>${i.comparison.median}</b></span>
            <span>разница: <b>${i.comparison.delta>0?'+':''}${i.comparison.delta}</b></span>
            <span>${i.comparison.rank}</span></div>` : ''}
        ${i.detail ? `<div class="detail">${i.detail}</div>`:''}
        <div class="clips"></div>
      </div>`;
    d.querySelector('.top').onclick = ()=>{
      d.classList.toggle('open');
      const c = d.querySelector('.clips');
      if(d.classList.contains('open') && !c.childElementCount) i.clips.forEach(x=>c.appendChild(clipCard(x)));
    };
    box.appendChild(d);
  });
  $('#n-ins').textContent = R.insights.length;
}

/* ------------------------------- плитки -------------------------------- */
function tile(k,v,d,cls){
  const t = el('div','tile');
  t.innerHTML = `<div class="k">${k}</div><div class="v">${v}</div>
    <div class="d ${cls||''}">${d||''}</div>`;
  return t;
}
function blRow(key){ return (R.baseline.rows||[]).find(r=>r.key===key); }
function vsLeague(key,val,lowerBetter){
  const b = blRow(key); if(!b||val===null||val===undefined) return ['',''];
  const d = +(val-b.median).toFixed(2);
  const better = lowerBetter ? d<0 : d>0;
  return [`лига ${b.median} · ${d>0?'+':''}${d}`, better?'up':'down'];
}
function renderTiles(){
  const box = $('#tiles');
  const pp=M.possession_profile||{}, dl=M.defensive_line||{}, bs=M.block_shape||{},
        tm=M.threat_map||{}, ob=M.off_ball_runs||{}, pg=M.progression||{}, pd=M.ppda||{},
        rz=M.regain_zones||{}, sh=M.shots||{};
  const items = [
    ['Владение', (pp.possession_share??'—')+'%', ...vsLeague('possession',pp.possession_share,false)],
    ['PPDA', num(pd.value), ...vsLeague('ppda',pd.value,true)],
    ['Высота линии обороны', num(dl.mean)+' м', ...vsLeague('line_height',dl.mean,false)],
    ['Ширина блока без мяча', num(bs.mean_width)+' м', ...vsLeague('block_width',bs.mean_width,false)],
    ['Создано xT за матч', num(tm.total), ...vsLeague('threat',tm.total,false)],
    ['Ударов за матч', num(sh.per_match), '', ''],
    ['Забеганий за матч', num(ob.per_match), ...vsLeague('runs',ob.per_match,false)],
    ['Из них использовано', num(ob.used_share)+'%', ...vsLeague('runs_used',ob.used_share,false)],
    ['Взломов линий за матч', num(pg.per_match), ...vsLeague('breaks',pg.per_match,false)],
    ['Отборов на чужой половине', num(rz.high_share)+'%', ...vsLeague('high_regains',rz.high_share,false)],
    ['Потерь за матч', num((M.losses||{}).per_match), ...vsLeague('losses',(M.losses||{}).per_match,true)],
    ['Длина фазы атаки', num(pp.mean_phase_duration)+' с', ...vsLeague('phase_duration',pp.mean_phase_duration,false)],
  ];
  items.forEach(a=>box.appendChild(tile(a[0],a[1],a[2],a[3])));
}

/* -------------------------------- поле --------------------------------- */
const PX=1050, PY=680;                        // 105×68 м → 10 px на метр
const fx = x => (x+52.5)*10, fy = y => (34-y)*10;
function pitchBase(svg,{flip=false}={}){
  svg.innerHTML='';
  const g = document.createElementNS('http://www.w3.org/2000/svg','g');
  const add=(t,a)=>{const e=document.createElementNS('http://www.w3.org/2000/svg',t);
    for(const k in a)e.setAttribute(k,a[k]); g.appendChild(e); return e;};
  add('rect',{x:0,y:0,width:PX,height:PY,fill:'#0d1c2c',rx:8});
  const st={stroke:'#2a4560','stroke-width':2,fill:'none'};
  add('rect',{x:10,y:10,width:PX-20,height:PY-20,...st});
  add('line',{x1:PX/2,y1:10,x2:PX/2,y2:PY-10,...st});
  add('circle',{cx:PX/2,cy:PY/2,r:91.5,...st});
  add('circle',{cx:PX/2,cy:PY/2,r:4,fill:'#2a4560'});
  add('rect',{x:10,y:PY/2-201,width:165,height:402,...st});
  add('rect',{x:PX-175,y:PY/2-201,width:165,height:402,...st});
  add('rect',{x:10,y:PY/2-91,width:55,height:182,...st});
  add('rect',{x:PX-65,y:PY/2-91,width:55,height:182,...st});
  svg.appendChild(g);
  return add;
}
function svgAdd(svg,t,a,text){
  const e=document.createElementNS('http://www.w3.org/2000/svg',t);
  for(const k in a)e.setAttribute(k,a[k]);
  if(text!==undefined)e.textContent=text;
  svg.appendChild(e); return e;
}
function renderPositions(){
  const svg=$('#pitch-pos'); pitchBase(svg);
  const ap = M.avg_positions||{}; const nodes=ap.nodes||[], edges=ap.edges||[];
  if(!nodes.length){ svgAdd(svg,'text',{x:PX/2,y:PY/2,fill:'#8ba2c0','text-anchor':'middle'},'нет данных'); return; }
  const byId={}; nodes.forEach(n=>byId[n.id]=n);
  const mx = Math.max(...edges.map(e=>e.n),1);
  edges.forEach(e=>{ const a=byId[e.a],b=byId[e.b]; if(!a||!b)return;
    svgAdd(svg,'line',{x1:fx(a.x),y1:fy(a.y),x2:fx(b.x),y2:fy(b.y),
      stroke:'#3b82e8','stroke-opacity':(0.16+0.5*e.n/mx).toFixed(2),
      'stroke-width':(1.5+5*e.n/mx).toFixed(1)});});
  const mt = Math.max(...nodes.map(n=>n.touches),1);
  // Два прохода: сначала все кружки, потом подписи — иначе поздние кружки
  // перекрывают ранние подписи.
  const geom = nodes.map(n=>({n, r:15+20*Math.sqrt(n.touches/mt), X:fx(n.x), Y:fy(n.y)}));
  geom.forEach(g=>{
    svgAdd(svg,'circle',{cx:g.X,cy:g.Y,r:g.r,fill:'#12325c',stroke:'#8fbdf5','stroke-width':2});
    svgAdd(svg,'text',{x:g.X,y:g.Y+6,fill:'#e9f0f9','text-anchor':'middle',
      'font-size':17,'font-weight':700},g.n.pos||'');
  });
  const placed=[];
  geom.slice().sort((a,b)=>a.Y-b.Y).forEach(g=>{
    const w = 5.5*g.n.name.length;
    let ly=g.Y+g.r+19, guard=0;
    const hits = y => placed.some(p=>Math.abs(p.x-g.X)<(p.w+w)/2+8 && Math.abs(p.y-y)<18)
                   || geom.some(o=>o!==g && Math.abs(o.X-g.X)<(w/2+o.r) && Math.abs(o.Y-y)<o.r+7);
    while(hits(ly) && guard++<10) ly += 19;
    if(guard>=10){ ly=g.Y-g.r-11; guard=0; while(hits(ly)&&guard++<8) ly-=19; }
    placed.push({x:g.X,y:ly,w});
    svgAdd(svg,'text',{x:g.X,y:ly,fill:'#c6d7ea','text-anchor':'middle','font-size':17,
      stroke:'#0d1c2c','stroke-width':5,'paint-order':'stroke'},g.n.name);
  });
  svgAdd(svg,'text',{x:26,y:PY-24,fill:'#54759f','font-size':19},'атака →');
}
function renderBlock(){
  const host=$('#pitch-block-host');
  const bs=M.block_shape||{};
  const order=['высокий блок','средний блок','низкий блок'];
  const rows=(bs.rows||[]).filter(r=>order.includes(r.phase)).sort((a,b)=>order.indexOf(a.phase)-order.indexOf(b.phase));
  const dl=M.defensive_line||{}; const byPhase={}; (dl.by_phase||[]).forEach(r=>byPhase[r.phase]=r.height);
  const colors={'высокий блок':'#e2593f','средний блок':'#d9a441','низкий блок':'#3b82e8'};
  host.innerHTML='';
  rows.forEach(r=>{
    const card=el('div','card');
    const svg=document.createElementNS('http://www.w3.org/2000/svg','svg');
    svg.setAttribute('viewBox','0 0 1050 680'); svg.setAttribute('class','pitch');
    card.appendChild(svg);
    card.appendChild(el('div','legend',
      `<span><i style="background:${colors[r.phase]}"></i><b style="color:var(--text)">${r.phase}</b></span>
       <span>${r.share}% фаз обороны (${r.n})</span>
       <span>линия — ${byPhase[r.phase]??'—'} м от своих ворот</span>`));
    host.appendChild(card);
    pitchBase(svg);
    // Ворота команды слева (x = −52.5). Высота линии — расстояние до последнего защитника.
    const h = byPhase[r.phase] ?? 30;
    const frontX = -52.5 + h;
    const backX  = -52.5 + Math.max(h - r.length, 0);
    const x1=fx(backX), x2=fx(frontX), y1=fy(r.width/2), y2=fy(-r.width/2);
    svgAdd(svg,'rect',{x:x1,y:y1,width:x2-x1,height:y2-y1,fill:colors[r.phase],'fill-opacity':.14,
      stroke:colors[r.phase],'stroke-width':3,rx:5});
    svgAdd(svg,'line',{x1:x2,y1:y1,x2:x2,y2:y2,stroke:colors[r.phase],'stroke-width':5});
    svgAdd(svg,'text',{x:(x1+x2)/2,y:y1-14,fill:colors[r.phase],'text-anchor':'middle',
      'font-size':34,'font-weight':700},`${r.width} × ${r.length} м`);
    // Свободная зона по флангам — то, что блок не закрывает.
    [[y1-fy(34), fy(34), 'сверху'],[fy(-34)-y2, y2, 'снизу']].forEach(()=>{});
    svgAdd(svg,'rect',{x:x1,y:fy(34),width:x2-x1,height:y1-fy(34),fill:'#e2593f','fill-opacity':.06});
    svgAdd(svg,'rect',{x:x1,y:y2,width:x2-x1,height:fy(-34)-y2,fill:'#e2593f','fill-opacity':.06});
    const free=((68-r.width)/2).toFixed(0);
    svgAdd(svg,'text',{x:(x1+x2)/2,y:fy(34)+((y1-fy(34))/2)+10,fill:'#e8a08e','text-anchor':'middle',
      'font-size':28},`${free} м свободно`);
    svgAdd(svg,'text',{x:(x1+x2)/2,y:y2+((fy(-34)-y2)/2)+10,fill:'#e8a08e','text-anchor':'middle',
      'font-size':28},`${free} м свободно`);
    svgAdd(svg,'text',{x:26,y:44,fill:'#54759f','font-size':26},'их ворота');
    svgAdd(svg,'text',{x:PX-26,y:44,fill:'#54759f','font-size':26,'text-anchor':'end'},'← атака соперника');
  });
}
function heat(svgId,grid,label,color){
  const svg=$(svgId); if(!svg) return; pitchBase(svg);
  if(!grid||!grid.length){ svgAdd(svg,'text',{x:PX/2,y:PY/2,fill:'#8ba2c0','text-anchor':'middle'},'нет данных'); return; }
  const ny=grid.length, nx=grid[0].length;
  const mx=Math.max(...grid.flat(),1e-9);
  const w=(PX-20)/nx, h=(PY-20)/ny;
  for(let i=0;i<ny;i++)for(let j=0;j<nx;j++){
    const v=grid[i][j]/mx;
    svgAdd(svg,'rect',{x:10+j*w,y:10+i*h,width:w,height:h,fill:color,'fill-opacity':(0.06+0.72*v).toFixed(3)});
    if(grid[i][j]>0) svgAdd(svg,'text',{x:10+j*w+w/2,y:10+i*h+h/2+5,'text-anchor':'middle',
      fill: v>0.45?'#fff':'#7d97b6','font-size':20},
      (mx<10? grid[i][j].toFixed(2) : Math.round(grid[i][j])));
  }
  svgAdd(svg,'text',{x:26,y:PY-24,fill:'#8ba2c0','font-size':22},label);
}
/* ------------------------------ блоки-графики -------------------------- */
function renderDLine(){
  const dl=M.defensive_line||{}; const box=$('#dline');
  const rows=(dl.by_phase||[]);
  if(!rows.length){box.textContent='нет данных';return;}
  const mx=Math.max(...rows.map(r=>r.height),1);
  box.innerHTML = `<table><thead><tr><th>Фаза обороны</th><th class="num">Высота, м</th>
    <th style="width:45%"></th><th class="num">Эпизодов</th></tr></thead><tbody>`+
    rows.map(r=>`<tr><td>${r.phase}</td><td class="num">${r.height}</td>
      <td><div class="bar"><i style="width:${100*r.height/mx}%"></i></div></td>
      <td class="num">${r.n}</td></tr>`).join('')+`</tbody></table>
    <div class="note" style="margin:12px 0 0">По 15-минутным отрезкам: `+
    (dl.by_time||[]).map(r=>`${r.bucket} — <b style="color:var(--text)">${r.height}</b> м`).join(' · ')+`</div>`;
}
function renderRhythm(){
  const tp=M.time_profile||{}; const rows=tp.rows||[]; const box=$('#rhythm');
  if(!rows.length){box.textContent='нет данных';return;}
  const mx=Math.max(...rows.map(r=>Math.max(r.xthreat,r.xthreat_against)),0.01);
  const W=1000,H=210,pad=34, bw=(W-2*pad)/rows.length;
  let s=`<svg viewBox="0 0 ${W} ${H+52}" style="width:100%">`;
  rows.forEach((r,i)=>{
    const x=pad+i*bw;
    const h1=H*r.xthreat/mx, h2=H*r.xthreat_against/mx;
    s+=`<rect x="${x+bw*0.12}" y="${H-h1}" width="${bw*0.34}" height="${h1}" fill="#3b82e8" rx="3"/>`;
    s+=`<rect x="${x+bw*0.52}" y="${H-h2}" width="${bw*0.34}" height="${h2}" fill="#e2593f" rx="3"/>`;
    s+=`<text x="${x+bw/2}" y="${H+20}" text-anchor="middle" fill="#8ba2c0" font-size="13">${r.bucket}</text>`;
    s+=`<text x="${x+bw*0.29}" y="${H-h1-6}" text-anchor="middle" fill="#8fbdf5" font-size="12">${r.xthreat}</text>`;
    s+=`<text x="${x+bw*0.69}" y="${H-h2-6}" text-anchor="middle" fill="#e8a08e" font-size="12">${r.xthreat_against}</text>`;
    s+=`<text x="${x+bw/2}" y="${H+40}" text-anchor="middle" fill="#54759f" font-size="12">${r.shots}/${r.shots_against} уд.</text>`;
  });
  s+='</svg>';
  box.innerHTML=s+`<div class="legend"><span><i style="background:#3b82e8"></i>xT создано за матч</span>
    <span><i style="background:#e2593f"></i>xT пропущено за матч</span>
    <span>под осью — удары свои/соперника за всю выборку</span></div>`;
}
