    t.forEach(p=>{ const X=10+400*((p.x-25)/27.5); const Y=210-300*(p.y/68);
      s+=`<circle cx="${Math.max(12,Math.min(408,X))}" cy="${Math.max(62,Math.min(358,Y))}" r="7"
        fill="${p.shot?'#e2593f':'#3b82e8'}" fill-opacity=".8"/>`; });
    s+=`</svg><div class="legend"><span><i style="background:#e2593f"></i>подача привела к удару</span>
      <span><i style="background:#3b82e8"></i>без удара</span>
