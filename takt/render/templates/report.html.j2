/* ------------------------------- паттерны ------------------------------ */
function scorePattern(p,q){
  if(!q) return 0;
  const s=q.toLowerCase().trim();
  let best=0;
  p.words.concat([p.name.toLowerCase()]).forEach(w=>{
    if(w.includes(s)||s.includes(w)) best=Math.max(best, w.length>=s.length? 2:1.5);
    const wt=w.split(/\s+/), st=s.split(/\s+/);
    const hit=st.filter(t=>t.length>2&&wt.some(x=>x.startsWith(t.slice(0,Math.max(4,t.length-2))))).length;
    if(hit) best=Math.max(best, hit/st.length);
  });
  return best;
}
function renderPatterns(q){
  const box=$('#pat-results'); box.innerHTML='';
  let list=R.patterns.map(p=>({p,s:scorePattern(p,q)}));
  if(q) list=list.filter(x=>x.s>0).sort((a,b)=>b.s-a.s);
  if(q && !list.length){ box.innerHTML=`<div class="card">Паттерн не распознан. Доступные: `+
    R.patterns.map(p=>p.name.toLowerCase()).join(' · ')+`</div>`; return; }
  list.forEach(({p})=>{
    const c=el('div','card'); c.style.marginBottom='12px';
    c.innerHTML=`<div style="display:flex;gap:12px;align-items:baseline">
      <div style="font-size:16px;font-weight:600">${p.name}</div>
      <div class="note" style="margin:0">${p.hint}</div>
      <div style="margin-left:auto;color:var(--accent-soft);font-size:13px">${p.n} эпизодов</div></div>
      <div class="clips"></div>`;
    const cl=c.querySelector('.clips'); p.clips.forEach(x=>cl.appendChild(clipCard(x)));
    box.appendChild(c);
  });
}

/* ------------------------------- плейлист ------------------------------ */
let ALL=[];
function buildPlaylist(){
  const seen=new Set();
  R.patterns.forEach(p=>p.clips.forEach(c=>{
    const k=c.match_id+'|'+c.frame+'|'+p.id;
    if(seen.has(k))return; seen.add(k);
    ALL.push({...c,pattern:p.name,pid:p.id});
  }));
  $('#n-clip').textContent=ALL.length;
  $('#n-pat').textContent=R.patterns.length;
  const fm=$('#f-match'); fm.innerHTML='<option value="">все матчи</option>'+
    R.matches.map(m=>`<option value="${m.id}">${m.date} · ${m.opponent} (${m.venue})</option>`).join('');
  const fp=$('#f-pattern'); fp.innerHTML='<option value="">все паттерны</option>'+
    R.patterns.map(p=>`<option value="${p.id}">${p.name}</option>`).join('');
  [fm,fp,$('#f-sort')].forEach(s=>s.onchange=renderPlaylist);
  renderPlaylist();
}
function renderPlaylist(){
  const mid=$('#f-match').value, pid=$('#f-pattern').value, sort=$('#f-sort').value;
  let l=ALL.filter(c=>(!mid||c.match_id===mid)&&(!pid||c.pid===pid));
  l.sort((a,b)=> sort==='t' ? a.t-b.t : (a.match_id+a.t).localeCompare(b.match_id+b.t));
  const box=$('#playlist');
  box.innerHTML=`<div class="note">${l.length} эпизодов</div>`;
  const g=el('div','clips'); g.style.maxHeight='none';
  l.slice(0,400).forEach(c=>{const d=clipCard(c);
    d.querySelector('.m').innerHTML=`${c.match}<br><span style="color:var(--low)">${c.pattern}</span>`;
    g.appendChild(d);});
  box.appendChild(g);
}
function openClip(c){
  const w=el('div','');
  w.style.cssText='position:fixed;inset:0;background:rgba(6,11,19,.86);z-index:99;display:flex;'+
    'align-items:center;justify-content:center;padding:24px';
  w.innerHTML=`<div class="card" style="max-width:520px;width:100%">
    <div style="font-size:12px;color:var(--muted);letter-spacing:.08em;text-transform:uppercase">эпизод</div>
    <div style="font-size:19px;margin:8px 0 4px">${c.title||''}</div>
    <div style="color:var(--muted);font-size:13.5px">${c.match}</div>
    <div style="display:flex;gap:20px;margin:16px 0;font-family:var(--mono);font-size:13px">
      <span>тайм-код видео <b style="color:var(--accent-soft)">${c.timecode}</b></span>
      <span>минута матча <b style="color:var(--accent-soft)">${c.clock}</b></span>
      <span>кадр <b style="color:var(--accent-soft)">${c.frame}</b></span></div>
    <div style="font-size:13px;color:var(--muted);line-height:1.6">
      Фаза: ${c.phase||'—'} · оборона соперника: ${c.def_phase||'—'}<br><br>
      В контуре клуба здесь открывается запись матча с этого тайм-кода. В демо видеофайлов нет:
      открытый датасет отдаёт только координаты и события.</div>
    <div style="margin-top:16px"><span class="chip on" id="closeclip">закрыть</span></div></div>`;
  w.onclick=e=>{if(e.target===w||e.target.id==='closeclip')w.remove();};
  document.body.appendChild(w);
}

/* ------------------------------- запуск -------------------------------- */
renderInsights(); renderTiles(); renderPositions(); renderBlock();
heat('#heat-threat',(M.threat_map||{}).grid,'xT за матч по зонам · атака →','#3b82e8');
heat('#heat-regain',(M.regain_zones||{}).grid,'возвраты мяча · их атака →','#3fae7a');
renderDLine(); renderRhythm(); renderSetPieces(); renderMatches(); renderPlayers(); renderFeed();
buildPlaylist(); renderPatterns('');
const chips=$('#chips');
['забегание за спину','высокий прессинг','взлом последней линии','смена фланга',
 'потеря в своей трети','низкий блок','контратака','угловой'].forEach(w=>{
  const c=el('span','chip',w); c.onclick=()=>{$('#q').value=w;renderPatterns(w);}; chips.appendChild(c);});
$('#q').oninput=e=>renderPatterns(e.target.value);
</script>
