      <td><span class="status ${r.status==='посчитано'?'ok':(r.status==='нет данных'?'no':'empty')}">${r.status}</span>
      ${r.missing.length?`<div class="note" style="margin:3px 0 0">не хватает: ${r.missing.join(', ')}</div>`:''}</td>
      </tr>`).join('')+`</tbody></table>`;
  const cc=$('#capchips'); (R.caps_present||[]).forEach(c=>cc.appendChild(el('span','chip on',c)));
  const b=R.baseline||{};
  $('#bl').innerHTML=`<table><thead><tr><th>Показатель</th><th class="num">${R.opponent}</th>
